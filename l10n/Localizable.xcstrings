      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das WLAN ist auf „Privat“ gestellt: Einstellungen → Netzwerk und Internet → WLAN → dein WLAN → Netzwerkprofiltyp „Privates Netzwerk“."

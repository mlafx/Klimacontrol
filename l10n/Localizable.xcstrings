    "host.mac.passwordStorage" : {
      "comment" : "Einstellungen → Verbindung, Hinweis zum Passwort (Mac)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort wird nur im macOS-Schlüsselbund gespeichert, damit sich Klimacontrol neu anmelden kann. Es verlässt den Mac nur zur Anmeldung bei Midea."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password is stored only in the macOS Keychain so that Klimacontrol can sign in again. It leaves the Mac only to sign in to Midea."
          }
        }
      }
    },
    "host.mac.setAsideDevice" : {
      "comment" : "Neu einrichten: was mit der Einrichtungsdatei geschieht (Mac)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtungsdatei kommt unverändert in den Papierkorb – Token und Schlüssel liegen danach im Papierkorb (wer ihn leert, verliert sie)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setup file goes to the Trash unchanged. The token and key are then in the Trash; emptying it deletes them."
          }
        }
      }
    },
    "host.mac.updatesHelp" : {
      "comment" : "Erklärung zu den Updates (Mac)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates werden automatisch geladen. Danach fragt Klimacontrol, ob es gleich neu starten soll; sonst wird beim Beenden installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates are downloaded automatically. Klimacontrol then asks whether to restart right away; otherwise the update is installed when the app quits."
          }
        }
      }
    },
    "host.windows.computer" : {
      "comment" : "Rechnerart Windows: Wort für den Rechner",

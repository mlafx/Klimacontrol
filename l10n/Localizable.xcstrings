{
  "sourceLanguage" : "en",
  "strings" : {
    "account.footerSignedIn" : {
      "comment" : "Fußnote Midea-Konto, angemeldet; storage = Satz zum Passwort (host.*.passwordStorage)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet. Bei „Automatisch“ springt das Midea-Konto ein, wenn WLAN nicht geht. {storage}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in. With “Automatic”, the Midea account takes over when Wi-Fi does not work. {storage}"
          }
        }
      }
    },
    "account.footerSignedOut" : {
      "comment" : "Fußnote Midea-Konto, nicht angemeldet; storage wie oben",
      "extractionState" : "manual",
      "localizations" : {

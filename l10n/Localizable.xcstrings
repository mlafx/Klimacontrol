    "reason.busyHint" : {
      "comment" : "Rat bei belegter Anlage",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermutlich hält sie die Klimacontrol-App (Diagnose offen) oder die Midea-App. Die andere App schließen oder 10 Sekunden warten und erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probably the Klimacontrol app (diagnostics open) or the Midea app is holding it. Close the other app, or wait 10 seconds and try again."
          }
        }
      }
    },
    "reason.busyShort" : {

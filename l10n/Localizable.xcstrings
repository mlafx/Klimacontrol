    "reason.refused" : {
      "comment" : "Grund: Verbindung abgewiesen (Text aus MideaKit, deutsch unverändert)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anlage weist die Verbindung ab. Stimmt die Adresse noch? Sonst „Adresse neu suchen“ – oder eine andere App hält die Anlage gerade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The air conditioner refuses the connection. Is the address still correct? If not, use “Find address again”, or another app is holding the air conditioner right now."
          }
        }
      }
    },
    "reason.timeout" : {

    "host.windows.credentialStore" : {
      "comment" : "Rechnerart Windows: Ort der Passwörter, im Satz nach „aus“",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "der Anmeldeinformationsverwaltung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows Credential Manager"
          }
        }
      }
    },
    "host.windows.passwordStorage" : {
      "comment" : "Einstellungen → Verbindung, Hinweis zum Passwort (Windows)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort wird nur in der Windows-Anmeldeinformationsverwaltung gespeichert, damit sich Klimacontrol neu anmelden kann. Es verlässt den Rechner nur zur Anmeldung bei Midea."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password is stored only in Windows Credential Manager so that Klimacontrol can sign in again. It leaves the computer only to sign in to Midea."
          }
        }
      }
    },
    "host.windows.setAsideDevice" : {
      "comment" : "Neu einrichten: was mit der Einrichtungsdatei geschieht (Windows)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtungsdatei wird nicht gelöscht, sondern unverändert im Datenordner beiseitegelegt. Token und Schlüssel bleiben in der Datei erhalten, bis du sie selbst löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setup file is not deleted but set aside unchanged in the data folder. The token and key stay in the file until you delete it yourself."
          }
        }
      }
    },
    "host.windows.updatesHelp" : {
      "comment" : "Erklärung zu den Updates (Windows)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimacontrol sucht nach Updates und zeigt sie im Update-Fenster. Ist „Updates automatisch installieren“ aus, wird erst nach „Jetzt installieren“ installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimacontrol checks for updates and shows them in the update window. With “Install updates automatically” off, updates are installed only after “Install now”."
          }
        }
      }
    },

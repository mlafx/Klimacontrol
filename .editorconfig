# Mac und Windows teilen diesen Ordner über OneDrive: überall LF und UTF-8, sonst laufen die zsh-Skripte nicht.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{swift,cs,py,ps1}]
indent_style = space
indent_size = 4

[*.{xaml,csproj,json,yml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

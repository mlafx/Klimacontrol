<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests der Windows-Oberfläche ohne Swift-DLL. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>KlimacontrolTray.Tests</RootNamespace>
    <!-- Die App ist eigenständig (SelfContained); die Tests laufen auf dem installierten .NET und brauchen davon nur
         die Assembly. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010;WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KlimacontrolTray\KlimacontrolTray.csproj" />
  </ItemGroup>

  <!-- Vertrag Swift ↔ C#: Muster des Schnappschusses für VertragTests. -->
  <ItemGroup>
    <None Include="Vertrag\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

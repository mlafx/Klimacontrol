<Window x:Class="KlimacontrolTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:KlimacontrolTray"
        Title="Klimacontrol"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <!-- Links Verlauf, Mitte Steuerung, rechts Diagnose; Breiten und Mindestgröße setzt MainWindow.xaml.cs nach den
       Regeln des Kerns (options.window, WindowLayoutMath). Größe und Mindestgröße kommen aus dem Code. -->
  <Window.Resources>
    <!-- Fußzeilen-Knöpfe ohne Rahmen, Fläche erst beim Darüberfahren; für Button und ToggleButton. -->
    <Style x:Key="FooterButton" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Back" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Umriss „Seitenleiste“; gefüllt, solange der Bereich eingeblendet ist. -->
    <Style x:Key="SidebarStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
      <Setter Property="StrokeThickness" Value="1.3"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SidebarFill" TargetType="Path">
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
      <Setter Property="Visibility" Value="Hidden"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Spalten Verlauf · Steuerung · Diagnose; Breiten setzt MainWindow.xaml.cs (Relayout). Spalte 0 ist der Rand vor
         der Steuerung, wenn sie allein in einem breiten Fenster steht. -->
    <Grid x:Name="AreaHost" ClipToBounds="True">
      <Grid x:Name="Area" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0"/>
          <ColumnDefinition Width="0"/>
          <ColumnDefinition Width="0"/>
          <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="HistoryHost" Grid.Column="1" Visibility="Collapsed">
          <ScrollViewer x:Name="HistoryScroll" Focusable="False" PanningMode="VerticalOnly"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="HistoryFill"/>
          </ScrollViewer>
          <!-- Trennlinie über dem Rand der Spalte: sie zählt zur Spaltenbreite, der Verlauf bekommt die volle Breite. -->
          <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Line}" IsHitTestVisible="False"/>
        </Grid>
        <ScrollViewer x:Name="ControlScroll" Grid.Column="2" Focusable="False" PanningMode="VerticalOnly"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="ControlFill"/>
        </ScrollViewer>
        <Grid x:Name="DiagHost" Grid.Column="3" Visibility="Collapsed">
          <ScrollViewer x:Name="DiagScroll" Focusable="False" PanningMode="VerticalOnly"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="DiagFill"/>
          </ScrollViewer>
          <Rectangle Width="1" HorizontalAlignment="Left" Fill="{DynamicResource Line}" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="1">
    <!-- Ansage, wenn eine Seitenspalte nicht mehr auf den Bildschirm passt (Text aus dem Katalog, verschwindet nach 10 s). -->
    <Border x:Name="HiddenBanner" Margin="12,0,12,8" Padding="10,8" CornerRadius="8"
            Background="{DynamicResource Tile}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HiddenText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button Grid.Column="1" Content="✕" Padding="6,2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                Click="DismissHidden_Click" ToolTip="{l:T common.dismiss}" AutomationProperties.Name="{l:T main.windows.dismissNotice}"/>
      </Grid>
    </Border>
    <!-- Hinweis, solange das ausführliche Protokoll in dieser Sitzung an ist (Text aus dem Kern). -->
    <TextBlock x:Name="DebugLogNote" Margin="14,0,14,6" FontSize="11.5" Foreground="{DynamicResource Sub}"
               TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>

    <!-- Fußzeile: Außenspalten gleich breit, damit die Mitte mittig bleibt; feste Beschriftungen, damit nichts springt. -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <ToggleButton x:Name="ChartsToggle" Style="{StaticResource FooterButton}" AutomationProperties.Name="{l:T main.footer.history}"
                        Checked="ChartsToggle_Changed" Unchecked="ChartsToggle_Changed">
            <StackPanel Orientation="Horizontal">
              <Grid Width="20" Height="20" Margin="0,0,7,0">
                <Path Style="{StaticResource SidebarFill}" Data="M6,2.5 H3.5 A2,2 0 0 0 1.5,4.5 V11.5 A2,2 0 0 0 3.5,13.5 H6 Z"/>
                <Path Style="{StaticResource SidebarStroke}"
                      Data="M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M6,2.5 V13.5"/>
              </Grid>
              <TextBlock Text="{l:T main.footer.history}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <!-- ProgressBar statt bloßem Path, damit Bedienungshilfen die Ladeanzeige finden. -->
          <ProgressBar x:Name="BusyRing" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Hidden"
                       IsIndeterminate="True" Focusable="False" IsTabStop="False" RenderTransformOrigin="0.5,0.5"
                       AutomationProperties.Name="{l:T main.windows.refreshingName}" ToolTip="{l:T main.windows.refreshingHelp}">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Path Data="M7,1.5 A5.5,5.5 0 1 1 1.5,7" Stroke="{DynamicResource Sub}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </ControlTemplate>
            </ProgressBar.Template>
            <ProgressBar.RenderTransform>
              <RotateTransform x:Name="BusySpin"/>
            </ProgressBar.RenderTransform>
          </ProgressBar>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource FooterButton}" Padding="7,4"
                  AutomationProperties.Name="{l:T main.footer.refresh}"
                  Click="Refresh_Click"/>
          <Button x:Name="SettingsButton" Style="{StaticResource FooterButton}" Margin="4,0,0,0" Padding="7,4"
                  AutomationProperties.Name="{l:T main.footer.settings}" Click="Settings_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <ToggleButton x:Name="DiagToggle" Style="{StaticResource FooterButton}" AutomationProperties.Name="{l:T main.footer.diagnostics}"
                        Checked="DiagToggle_Changed" Unchecked="DiagToggle_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T main.footer.diagnostics}" VerticalAlignment="Center"/>
              <Grid Width="20" Height="20" Margin="7,0,0,0">
                <Path Style="{StaticResource SidebarFill}" Data="M10,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H10 Z"/>
                <Path Style="{StaticResource SidebarStroke}"
                      Data="M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M10,2.5 V13.5"/>
              </Grid>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window x:Class="KlimacontrolTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klimacontrol" Width="506" Height="900" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <!-- Links Verlauf, Mitte Steuerung, rechts Diagnose; die Spalten baut MainWindow.xaml.cs nach Layout.cs. -->
  <Window.Resources>
    <!-- Reiter wie der Windows-11-SelectorBar: gewählt mit kurzem Akzentstrich darunter. -->
    <Style x:Key="PaneTab" TargetType="RadioButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="0,0,4,0">
              <Border x:Name="Back" CornerRadius="4" Background="Transparent"/>
              <ContentPresenter x:Name="Text" Margin="12,6,12,10" HorizontalAlignment="Center"/>
              <Border x:Name="Pill" Width="16" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                      Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Fg}"/>
                <Setter TargetName="Back" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fußzeilen-Knöpfe ohne Rahmen, Fläche erst beim Darüberfahren; für Button und ToggleButton. -->
    <Style x:Key="FooterButton" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Back" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Umriss „Seitenleiste“; gefüllt, solange der Bereich eingeblendet ist. -->
    <Style x:Key="SidebarStroke" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
      <Setter Property="StrokeThickness" Value="1.3"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SidebarFill" TargetType="Path">
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
      <Setter Property="Visibility" Value="Hidden"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Spalten baut MainWindow.xaml.cs (Relayout). -->
    <Grid x:Name="AreaHost" ClipToBounds="True">
      <Grid x:Name="Area" HorizontalAlignment="Center"/>
    </Grid>

    <!-- Fußzeile: Außenspalten gleich breit, damit die Mitte mittig bleibt; feste Beschriftungen, damit nichts springt. -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <ToggleButton x:Name="ChartsToggle" Style="{StaticResource FooterButton}" AutomationProperties.Name="Verlauf"
                        Checked="ChartsToggle_Changed" Unchecked="ChartsToggle_Changed">
            <StackPanel Orientation="Horizontal">
              <Grid Width="20" Height="20" Margin="0,0,7,0">
                <Path Style="{StaticResource SidebarFill}" Data="M6,2.5 H3.5 A2,2 0 0 0 1.5,4.5 V11.5 A2,2 0 0 0 3.5,13.5 H6 Z"/>
                <Path Style="{StaticResource SidebarStroke}"
                      Data="M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M6,2.5 V13.5"/>
              </Grid>
              <TextBlock Text="Verlauf" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <!-- ProgressBar statt bloßem Path, damit Bedienungshilfen die Ladeanzeige finden. -->
          <ProgressBar x:Name="BusyRing" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Hidden"
                       IsIndeterminate="True" Focusable="False" IsTabStop="False" RenderTransformOrigin="0.5,0.5"
                       AutomationProperties.Name="Wird aktualisiert" ToolTip="Wird aktualisiert …">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Path Data="M7,1.5 A5.5,5.5 0 1 1 1.5,7" Stroke="{DynamicResource Sub}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </ControlTemplate>
            </ProgressBar.Template>
            <ProgressBar.RenderTransform>
              <RotateTransform x:Name="BusySpin"/>
            </ProgressBar.RenderTransform>
          </ProgressBar>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="RefreshButton" Style="{StaticResource FooterButton}" Padding="7,4"
                  AutomationProperties.Name="Jetzt aktualisieren"
                  ToolTip="Jetzt aktualisieren – probiert alle Wege neu (Strg+R oder F5)" Click="Refresh_Click"/>
          <Button x:Name="SettingsButton" Style="{StaticResource FooterButton}" Margin="4,0,0,0" Padding="7,4"
                  AutomationProperties.Name="Einstellungen" ToolTip="Einstellungen (Strg+,)" Click="Settings_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <ToggleButton x:Name="DiagToggle" Style="{StaticResource FooterButton}" AutomationProperties.Name="Diagnose"
                        Checked="DiagToggle_Changed" Unchecked="DiagToggle_Changed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Diagnose" VerticalAlignment="Center"/>
              <Grid Width="20" Height="20" Margin="7,0,0,0">
                <Path Style="{StaticResource SidebarFill}" Data="M10,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H10 Z"/>
                <Path Style="{StaticResource SidebarStroke}"
                      Data="M3.5,2.5 H12.5 A2,2 0 0 1 14.5,4.5 V11.5 A2,2 0 0 1 12.5,13.5 H3.5 A2,2 0 0 1 1.5,11.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M10,2.5 V13.5"/>
              </Grid>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

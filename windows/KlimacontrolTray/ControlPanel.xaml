<UserControl x:Class="KlimacontrolTray.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KlimacontrolTray">
  <!-- Nur das Gerüst; den Inhalt setzt ControlPanel.xaml.cs je nach Zustand. -->
  <UserControl.Resources>
    <!-- Flacher Knopf für Sprungmarken und Zonen-Symbole am Lüfter: per Tab erreichbar, per Sprachausgabe
         bedienbar, Trefferfläche mindestens 22 px hoch. Fokusrahmen kommt aus dem Fluent-Design (BasedOn). -->
    <Style x:Key="FlatMark" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Tile}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Tile}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel x:Name="Root">
    <!-- Kopf: Name, Verbindung, Ein/Aus, Solltemperatur, Kennzahlen. Übereinander (Darstellung): die Fläche
         (Hero), der lebendige Hintergrund, der Inhalt (HeroBody), die Wetter-Ebene und bei Neon die leuchtende Kante. -->
    <Grid x:Name="HeroBox">
    <Border x:Name="Hero" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
    <local:AmbientLayer x:Name="LivelyLayer" Kind="Lively"/>
    <Border x:Name="HeroBody" Padding="16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="NameText" FontSize="17" FontWeight="SemiBold" Text="Klimaanlage"/>
            <!-- Verbindungszeile: Punkt grün/grau/orange, Text, Tooltip mit Adresse -->
            <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,2,0,0" Background="Transparent">
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
          <Button x:Name="PowerButton" Grid.Column="1" Width="46" Height="46" Padding="0" Click="Power_Click" ToolTip="Ein/Aus">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" CornerRadius="23" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>

        <!-- Ein: − 17° + und Regler 16–30 -->
        <StackPanel x:Name="OnPanel" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="MinusButton" Width="44" Height="44" Padding="0" VerticalAlignment="Center" Click="Minus_Click" ToolTip="Kälter"
                    AutomationProperties.Name="Kälter"/>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock x:Name="TargetText" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" Text="–"/>
              <TextBlock x:Name="GoalText" FontSize="13" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="PlusButton" Grid.Column="2" Width="44" Height="44" Padding="0" VerticalAlignment="Center" Click="Plus_Click" ToolTip="Wärmer"
                    AutomationProperties.Name="Wärmer"/>
          </Grid>
          <Grid x:Name="TempRow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Min16" FontSize="11" VerticalAlignment="Center"/>
            <Slider x:Name="TempSlider" Grid.Column="1" Margin="8,0" TickFrequency="1"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="TempSlider_ValueChanged"
                    AutomationProperties.Name="Solltemperatur"/>
            <TextBlock x:Name="Max30" Grid.Column="2" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <!-- Aus: Raumtemperatur groß -->
        <StackPanel x:Name="OffPanel" Margin="0,10,0,0" HorizontalAlignment="Center">
          <TextBlock x:Name="RoomBig" FontSize="54" FontWeight="Light" HorizontalAlignment="Center"/>
          <TextBlock x:Name="OffCaption" FontSize="13" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
          <TextBlock x:Name="OffHint" FontSize="11" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <UniformGrid x:Name="Readings" Rows="1" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
    <local:AmbientLayer x:Name="WeatherLayer" Kind="Weather"/>
    <!-- Neon: Kante in der Modusfarbe mit leichtem Schein – zwei blasse Ringe statt eines Effekts (Software-Zeichnen). -->
    <Grid x:Name="HeroEdge" IsHitTestVisible="False" Visibility="Collapsed">
      <Border x:Name="EdgeHalo2" Margin="-4" CornerRadius="12" BorderThickness="2"/>
      <Border x:Name="EdgeHalo1" Margin="-2" CornerRadius="10" BorderThickness="2"/>
      <Border x:Name="EdgeLine" CornerRadius="8" BorderThickness="1"/>
    </Grid>
    </Grid>

    <!-- Startanzeige: eingerichtet, aber noch kein Zustand (zuletzt bekannte Werte bzw. Skelett und Schritte). -->
    <local:ConnectingView x:Name="Connecting" Visibility="Collapsed"/>

    <UniformGrid x:Name="ModeGrid" Rows="1" Margin="-3,14,-3,0"/>

    <!-- Lüfter -->
    <StackPanel x:Name="FanPanel" Margin="0,16,0,0">
      <Grid>
        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Text="LÜFTER" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="FanValue" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <!-- Checked/Unchecked statt Click: auch Leertaste und Sprachausgabe (Umschalten) schicken den Befehl. -->
          <ToggleButton x:Name="FanAuto" Content="Auto" FontSize="12" Padding="10,3" Checked="FanAuto_Changed" Unchecked="FanAuto_Changed"
                        AutomationProperties.Name="Lüfter automatisch"/>
        </StackPanel>
      </Grid>
      <!-- Spur selbst gezeichnet (FanTrack): fest 1–100 %, beim Kühlen/Heizen links gestrichelt bis „Außengerät leise“,
           rechts bis „Turbo“. Vom Regler bleibt nur der Knopf. -->
      <Grid Margin="0,6,0,0">
        <Canvas x:Name="FanTrack" IsHitTestVisible="False"/>
        <Slider x:Name="FanSlider" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                FocusVisualStyle="{x:Null}" ValueChanged="FanSlider_ValueChanged" SizeChanged="FanSlider_SizeChanged"
                AutomationProperties.Name="Lüfter in Prozent">
          <Slider.Template>
            <ControlTemplate TargetType="Slider">
              <Grid Height="24" Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" IsTabStop="False"/>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" IsTabStop="False"/>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="20" Height="20">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <!-- Knopf wie der Windows-11-Regler: Ring in Flächenfarbe, Punkt in der Modusfarbe. -->
                          <Grid>
                            <Ellipse Fill="{DynamicResource Card}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Dot" Property="Width" Value="12"/>
                              <Setter TargetName="Dot" Property="Height" Value="12"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Dot" Property="Width" Value="8"/>
                              <Setter TargetName="Dot" Property="Height" Value="8"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Slider.Template>
        </Slider>
      </Grid>
      <!-- Eine Zeile: Sprungmarken an ihrer Position, die Zonen als Symbole ganz außen (flache Knöpfe, FlatMark). -->
      <Canvas x:Name="FanMarks" Height="22" ClipToBounds="False"/>
    </StackPanel>

    <!-- Umfang „Einfach“: Komfort, weitere Funktionen und Szenen unter „Mehr …“ (Zustand für die Sitzung). -->
    <ToggleButton x:Name="MoreToggle" Margin="0,12,0,0" HorizontalAlignment="Stretch" Cursor="Hand" Visibility="Collapsed"
                  Checked="MoreToggle_Changed" Unchecked="MoreToggle_Changed"
                  ToolTip="Komfort, weitere Funktionen und Szenen ein- oder ausblenden" AutomationProperties.Name="Mehr">
      <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Box" Background="Transparent" MinHeight="22" Padding="0,2" CornerRadius="4">
            <DockPanel>
              <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="10" Text="&#xE70D;" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                         Margin="8,0,2,0"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.75"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Tile}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </ToggleButton.Template>
      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Text="MEHR …"/>
    </ToggleButton>

    <!-- Komfort -->
    <StackPanel x:Name="ComfortPanel" Margin="0,12,0,0">
      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Text="KOMFORT" Margin="0,0,0,6"/>
      <UniformGrid x:Name="ComfortGrid" Rows="1" Margin="-3,0"/>
      <!-- Weitere Funktionen: immer sichtbar wie am Mac (nichts hinter einem Klappmenü verstecken). -->
      <StackPanel x:Name="MorePanel" Margin="0,14,0,0">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Text="WEITERE FUNKTIONEN" Margin="0,0,0,6"/>
          <UniformGrid x:Name="MoreGrid" Columns="3" Margin="-3,0"/>
          <Grid x:Name="RateRow" Margin="0,10,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentControl x:Name="RateIcon" VerticalAlignment="Center" Margin="0,0,6,0" Focusable="False" IsTabStop="False"/>
              <TextBlock FontSize="13" VerticalAlignment="Center" Text="Leistung begrenzen"/>
            </StackPanel>
            <!-- RadioButton im Knopf-Stil: Pfeiltasten, Leertaste und Sprachausgabe schicken den Befehl wie ein Klick. -->
            <StackPanel x:Name="RatePanel" Orientation="Horizontal" HorizontalAlignment="Right"
                        AutomationProperties.Name="Leistung begrenzen"/>
          </Grid>
      </StackPanel>
    </StackPanel>

    <!-- Szenen und Timer: eigene Bausteine (ScenesSection, TimerRow), melden sich selbst beim Kern an und setzen
         ihren Abstand nach oben selbst (je nach Compact). -->
    <local:ScenesSection x:Name="Scenes"/>
    <local:TimerRow x:Name="Timers"/>

    <!-- Meldung: Fehler orange mit Warndreieck, „Anlage ausgeschaltet“ ruhig grau. -->
    <Border x:Name="MessageBanner" Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="MessageIcon" VerticalAlignment="Top" Margin="0,1,8,0" Focusable="False" IsTabStop="False"/>
        <!-- Neue Meldungen sagt die Sprachausgabe an: Fehler sofort, „Anlage ausgeschaltet“ höflich (Code).
             Mit MessageDetail zwei Zeilen „Was ist passiert.“ (fett) / „Was tun.“ und der Code klein am Ende. -->
        <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Assertive"/>
        <Button x:Name="RetryButton" Grid.Column="2" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                VerticalAlignment="Center" Click="Retry_Click" ToolTip="Sofort neu abfragen"/>
        <Button Grid.Column="3" Content="✕" Padding="6,2" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                Click="DismissMessage_Click" ToolTip="Ausblenden" AutomationProperties.Name="Meldung ausblenden"/>
      </Grid>
    </Border>

    <!-- Hinweis zu einem Befehl: ruhig in Grau, der Kern blendet ihn nach 10 s aus. -->
    <Border x:Name="NoticeBanner" Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Tile}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="NoticeIcon" VerticalAlignment="Top" Margin="0,1,8,0" Focusable="False" IsTabStop="False"/>
        <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
        <Button Grid.Column="2" Content="✕" Padding="6,2" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                Click="DismissNotice_Click" ToolTip="Ausblenden" AutomationProperties.Name="Hinweis ausblenden"/>
      </Grid>
    </Border>

    <!-- Noch nicht eingerichtet -->
    <StackPanel x:Name="SetupPanel" Visibility="Collapsed" Margin="0,8,0,0">
      <local:SetupView x:Name="Setup"/>
      <!-- Fenster am Infobereich (InlineSetup = false): nur der Weg ins Hauptfenster.
           Kein eigener Knopf: „Klimacontrol öffnen“ steht unten im Fenster am Infobereich schon. -->
      <StackPanel x:Name="SetupHint" Visibility="Collapsed">
        <TextBlock FontSize="13" TextWrapping="Wrap"
                   Text="Noch keine Anlage eingerichtet – das geht im Hauptfenster („Klimacontrol öffnen“)."/>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>

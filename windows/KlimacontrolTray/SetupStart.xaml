<UserControl x:Class="KlimacontrolTray.SetupStart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Startseite der Einrichtung: Weg wählen. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SetupStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ChoiceCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      </Style>
      <Style x:Key="ChoiceTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ChoiceDetail" TargetType="TextBlock" BasedOn="{StaticResource Small}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <ContentControl x:Name="HeadIcon" HorizontalAlignment="Left" Margin="0,0,0,4" Focusable="False"/>
    <TextBlock Style="{StaticResource SetupTitle}" Text="Wie möchtest du verbinden?"/>
    <TextBlock Style="{StaticResource SetupDetail}"
               Text="Klimacontrol steuert die Anlage direkt im WLAN. Dafür braucht es einmalig Token und Schlüssel der Anlage."/>

    <Button x:Name="AccountCard" Style="{StaticResource ChoiceCard}" Click="Account_Click"
            AutomationProperties.Name="Mit Midea-Konto, empfohlen">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="AccountIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <WrapPanel>
            <TextBlock Style="{StaticResource ChoiceTitle}" Text="Mit Midea-Konto" Margin="0,0,6,0"/>
            <Grid VerticalAlignment="Center">
              <Border CornerRadius="8" Background="{DynamicResource Accent}" Opacity="0.2"/>
              <TextBlock Text="empfohlen" FontSize="11" FontWeight="Medium" Margin="6,1,6,1"/>
            </Grid>
          </WrapPanel>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="Holt Token und Schlüssel automatisch. Findet die Anlage auch, wenn sie ausgeschaltet ist."/>
        </StackPanel>
        <ContentControl x:Name="AccountChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>

    <Button x:Name="ManualCard" Style="{StaticResource ChoiceCard}" Click="Manual_Click"
            AutomationProperties.Name="Zugangsdaten eingeben">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="ManualIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource ChoiceTitle}" Text="Zugangsdaten eingeben"/>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="Token und Schlüssel liegen dir schon vor. Kein Midea-Konto nötig."/>
        </StackPanel>
        <ContentControl x:Name="ManualChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>

    <Button x:Name="BackupCard" Style="{StaticResource ChoiceCard}" Click="Import_Click"
            AutomationProperties.Name="Sicherung einlesen">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="BackupIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource ChoiceTitle}" Text="Sicherung einlesen"/>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="Sicherungsdatei mit den Zugangsdaten, z. B. von einem anderen Rechner."/>
        </StackPanel>
        <ContentControl x:Name="BackupChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>
    <TextBlock x:Name="ImportResult" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

    <!-- Fußzeile -->
    <TextBlock FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Right"
               ToolTip="Protokoll und Verbindung in den Einstellungen (Strg+,)">
      <Hyperlink Click="Settings_Click">Einstellungen …</Hyperlink>
    </TextBlock>
  </StackPanel>
</UserControl>

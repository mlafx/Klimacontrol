<UserControl x:Class="KlimacontrolTray.SetupStart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:KlimacontrolTray">
  <!-- Startseite der Einrichtung: Weg wählen. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SetupStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ChoiceCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      </Style>
      <Style x:Key="ChoiceTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ChoiceDetail" TargetType="TextBlock" BasedOn="{StaticResource Small}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <ContentControl x:Name="HeadIcon" HorizontalAlignment="Left" Margin="0,0,0,4" Focusable="False"/>
    <TextBlock Style="{StaticResource SetupTitle}" Text="{l:T setup.view.start.title}"/>
    <TextBlock Style="{StaticResource SetupDetail}"
               Text="{l:T setup.view.start.intro}"/>

    <Button x:Name="AccountCard" Style="{StaticResource ChoiceCard}" Click="Account_Click"
            AutomationProperties.Name="{l:T setup.view.windows.choiceAccountName}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="AccountIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <WrapPanel>
            <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:T setup.view.choice.account.title}" Margin="0,0,6,0"/>
            <Grid VerticalAlignment="Center">
              <Border CornerRadius="8" Background="{DynamicResource Accent}" Opacity="0.2"/>
              <TextBlock Text="{l:T setup.view.recommended}" FontSize="11" FontWeight="Medium" Margin="6,1,6,1"/>
            </Grid>
          </WrapPanel>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="{l:T setup.view.windows.choiceAccountDetail}"/>
        </StackPanel>
        <ContentControl x:Name="AccountChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>

    <Button x:Name="ManualCard" Style="{StaticResource ChoiceCard}" Click="Manual_Click"
            AutomationProperties.Name="{l:T setup.view.choice.manual.title}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="ManualIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:T setup.view.choice.manual.title}"/>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="{l:T setup.view.windows.choiceManualDetail}"/>
        </StackPanel>
        <ContentControl x:Name="ManualChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>

    <Button x:Name="BackupCard" Style="{StaticResource ChoiceCard}" Click="Import_Click"
            AutomationProperties.Name="{l:T setup.view.choice.backup.title}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="BackupIcon" VerticalAlignment="Top" HorizontalAlignment="Left" Focusable="False"/>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:T setup.view.choice.backup.title}"/>
          <TextBlock Style="{StaticResource ChoiceDetail}"
                     Text="{l:T setup.view.windows.choiceBackupDetail}"/>
        </StackPanel>
        <ContentControl x:Name="BackupChevron" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"/>
      </Grid>
    </Button>
    <TextBlock x:Name="ImportResult" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

    <!-- Fußzeile -->
    <TextBlock x:Name="SettingsLinkText" FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Hyperlink Click="Settings_Click"><Run Text="{l:T setup.view.settings.link}"/></Hyperlink>
    </TextBlock>
  </StackPanel>
</UserControl>

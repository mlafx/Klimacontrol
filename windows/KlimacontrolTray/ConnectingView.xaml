<UserControl x:Class="KlimacontrolTray.ConnectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:KlimacontrolTray">
  <!-- Startanzeige bis zur ersten Antwort; den Inhalt setzt ConnectingView.xaml.cs. -->
  <Border x:Name="Card" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource Line}"
          Background="{DynamicResource Tile}">
    <StackPanel>
      <TextBlock x:Name="NameText" FontSize="17" FontWeight="SemiBold" Text="{l:T message.defaultName}"/>
      <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,2,0,0" Background="Transparent">
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <!-- Zuletzt bekannte Werte aus dem Verlauf: grau und blass, damit sie nicht wie live wirken. -->
      <StackPanel x:Name="LastPanel" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="LastMain" FontSize="56" FontWeight="Light" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Sub}" Opacity="0.6"/>
        <TextBlock x:Name="LastCaption" FontSize="13" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="LastValues" FontSize="11" Foreground="{DynamicResource Sub}" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Ohne Verlauf: graue Platzhalterflächen statt erfundener Zahlen (für die Sprachausgabe unsichtbar). -->
      <StackPanel x:Name="Skeleton" Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7">
        <Rectangle x:Name="SkelBig" Width="96" Height="52" RadiusX="8" RadiusY="8" Fill="{DynamicResource Line}"
                   HorizontalAlignment="Center"/>
        <Rectangle Width="170" Height="12" RadiusX="4" RadiusY="4" Fill="{DynamicResource Line}" Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
        <Rectangle Width="120" Height="10" RadiusX="4" RadiusY="4" Fill="{DynamicResource Line}" Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Schritte (nur ohne Meldung); nach 10 s „Dauert länger als üblich“ mit „Erneut versuchen“. -->
      <StackPanel x:Name="StepsPanel" Margin="0,14,0,0">
        <TextBlock x:Name="StepsText" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <Grid x:Name="SlowRow" Margin="0,6,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SlowText" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"
                     VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
          <Button x:Name="RetryButton" Grid.Column="1" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                  VerticalAlignment="Center" Click="Retry_Click"/>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

<UserControl x:Class="KlimacontrolTray.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <ContentControl x:Name="TitleIcon" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="Diagnose"/>
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Padding="6" Click="Close_Click" ToolTip="Diagnose ausblenden (Strg+D)"
              AutomationProperties.Name="Diagnose ausblenden" AutomationProperties.AcceleratorKey="Strg+D"/>
    </Grid>
    <TextBlock x:Name="LiveText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <StackPanel x:Name="Sections" Margin="0,4,0,0"/>
    <TextBlock x:Name="HintsText" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,12,0,0"
               Visibility="Collapsed"/>
    <Grid x:Name="Footer" Margin="0,16,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock FontSize="12" Foreground="{DynamicResource Sub}" Text="Verlauf in verlauf.sqlite" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="1" FontSize="12" Margin="8,0,0,0">
        <Hyperlink Click="Folder_Click" ToolTip="Ablageordner öffnen und verlauf.sqlite markieren">Im Explorer zeigen</Hyperlink>
      </TextBlock>
    </Grid>
  </StackPanel>
</UserControl>

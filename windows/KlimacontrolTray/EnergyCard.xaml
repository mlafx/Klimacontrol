<UserControl x:Class="KlimacontrolTray.EnergyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Padding="{DynamicResource CardPadding}" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource Tile}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="TitleHost" Orientation="Horizontal" VerticalAlignment="Center">
          <ContentControl x:Name="TitleIcon" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel x:Name="KindPanel" Grid.Column="1" Orientation="Horizontal"/>
      </Grid>
      <!-- Balken, Werte darüber, Durchschnitt, Achse rechts und Beschriftungen darunter zeichnet der Code. -->
      <Canvas x:Name="Plot" Grid.Row="1" Height="150" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"/>
      <TextBlock x:Name="NoDataText" Grid.Row="1" Margin="0,16" MinHeight="48" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                 Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>
      <WrapPanel x:Name="Footer" Grid.Row="2" Margin="0,8,0,0">
        <TextBlock x:Name="SummaryText" Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <StackPanel x:Name="AverageLegend" Orientation="Horizontal" VerticalAlignment="Center">
          <Line x:Name="AverageSample" X1="0" X2="16" Y1="1" Y2="1" Width="16" Height="2" StrokeThickness="1"
                StrokeDashArray="4 3" Stroke="{DynamicResource Fg}" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock x:Name="AverageText" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
        </StackPanel>
      </WrapPanel>
      <TextBlock x:Name="LegendText" Grid.Row="3" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
    </Grid>
  </Border>
</UserControl>

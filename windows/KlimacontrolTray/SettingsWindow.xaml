<Window x:Class="KlimacontrolTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KlimacontrolTray"
        Title="Klimacontrol – Einstellungen" Width="620" Height="640" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <!-- Reiterreihenfolge fest, muss zu `SettingsTab` passen: Allgemein, Darstellung, Verbindung, Anlage, Protokoll,
       Lizenzen (wie am Mac). -->
  <Window.Resources>
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="2,10,0,6"/>
    </Style>
    <Style x:Key="Foot" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedFoot}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedFoot}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Eine Einstellungszeile: links Titel/Erklärung, rechts das Bedienelement. -->
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,6"/>
    </Style>
    <!-- Darstellung: Farbkreis als Auswahl (RadioButton). Ring = gewählt, halber Ring = Maus darüber. -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="LookColor"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Fg}" StrokeThickness="2" Opacity="0"/>
              <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LookSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Width" Value="170"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="SmallChange" Value="1"/>
      <Setter Property="LargeChange" Value="5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Transparenz und Leuchten in 5-%-Schritten wie am Mac (Schritt 0,05). -->
    <Style x:Key="LookPercentSlider" TargetType="Slider" BasedOn="{StaticResource LookSlider}">
      <Setter Property="TickFrequency" Value="5"/>
      <Setter Property="SmallChange" Value="5"/>
      <Setter Property="LargeChange" Value="10"/>
    </Style>
    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="Width" Value="44"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ThemeChoice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="GroupName" Value="LookTheme"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
  </Window.Resources>

  <TabControl x:Name="Tabs" Margin="12">

    <!-- 0 Allgemein -->
    <TabItem Header="Allgemein">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource SectionHead}" Text="Anzeige"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Name"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Steht im Fenster und im Infobereich."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="NameBox" Width="190" AutomationProperties.Name="Name der Anlage" KeyDown="Name_KeyDown"/>
                  <Button Content="Übernehmen" Margin="6,0,0,0" Click="Name_Click"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Strompreis"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Für die Kosten in der Übersicht und im Verlauf (gilt auch rückwirkend für den Verlauf)."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="PriceBox" Width="70" TextAlignment="Right" KeyDown="Price_KeyDown"
                           AutomationProperties.Name="Strompreis in Euro je Kilowattstunde"/>
                  <TextBlock Text="€ je kWh" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Sub}"/>
                  <Button Content="Übernehmen" Margin="6,0,0,0" Click="Price_Click"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Aktualisierung"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Anlage abfragen alle"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Kürzer = aktueller, aber mehr Verkehr zur Anlage."/>
                </StackPanel>
                <ComboBox x:Name="RefreshBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                          AutomationProperties.Name="Anlage abfragen alle" SelectionChanged="Refresh_Changed"/>
              </Grid>
              <Grid x:Name="CustomRefreshPanel" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="CustomRefreshTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="CustomRefreshHelp" Style="{StaticResource RowHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="CustomRefreshBox" Width="60" TextAlignment="Right" KeyDown="CustomRefresh_KeyDown"
                           AutomationProperties.Name="Eigener Wert in Sekunden"/>
                  <TextBlock Text="s" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Sub}"/>
                  <Button Content="Übernehmen" Margin="6,0,0,0" Click="CustomRefresh_Click"/>
                </StackPanel>
              </Grid>
              <DockPanel x:Name="RefreshWarn" Margin="0,4,0,4" Visibility="Collapsed">
                <Path x:Name="RefreshWarnIcon" DockPanel.Dock="Left" Width="14" Height="14" Stretch="Uniform" Margin="0,1,6,0"
                      VerticalAlignment="Top" Stroke="{DynamicResource Warn}" StrokeThickness="1.4"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="RefreshWarnText" FontSize="11.5" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Verlauf"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Zusätzlich als CSV schreiben"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Der Verlauf liegt immer in verlauf.sqlite. Auf Wunsch zusätzlich alle 30 s eine Zeile in verlauf.csv."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="HistoryCsvBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Zusätzlich als CSV schreiben" Click="HistoryCsv_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Ganzen Verlauf exportieren"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Als CSV-Datei mit Ortszeit und deutschen Spalten, z. B. für Excel."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Im Explorer zeigen" Click="HistoryShow_Click"/>
                  <Button Content="Exportieren …" Margin="6,0,0,0" Click="HistoryExport_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="HistoryResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Der Autostart-Eintrag startet mit "- -tray" nur im Infobereich. -->
          <TextBlock Style="{StaticResource SectionHead}" Text="Start"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Mit Windows starten"/>
                  <TextBlock Style="{StaticResource RowHelp}"
                             Text="Startet beim Anmelden nur im Infobereich. Timer und Verlauf laufen nur, solange Klimacontrol läuft."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="AutostartBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Mit Windows starten" Click="Autostart_Click"/>
              </Grid>
              <TextBlock x:Name="AutostartHint" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,6"
                         Foreground="{DynamicResource Warn}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Tastatur"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Fenster am Infobereich öffnen"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Tastenkürzel, das in jedem Programm wirkt."/>
                </StackPanel>
                <ComboBox x:Name="HotkeyBox" Grid.Column="1" Width="190" VerticalAlignment="Center"
                          AutomationProperties.Name="Tastenkürzel für das Fenster am Infobereich"
                          SelectionChanged="Hotkey_Changed"/>
              </Grid>
              <Grid x:Name="HotkeyRecordPanel" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Eigene Kombination"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Ins Feld klicken und die Tasten zusammen drücken, mit Strg, Alt oder Win. Esc bricht ab."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="HotkeyRecordBox" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                           TextAlignment="Center" AutomationProperties.Name="Neue Tastenkombination"
                           PreviewKeyDown="HotkeyRecord_PreviewKeyDown"/>
                  <Button Content="Abbrechen" Margin="6,0,0,0" Click="HotkeyRecordCancel_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="HotkeyResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource RowHelp}" Margin="0,6,0,4" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Im Fenster:"/>
                <Run Text="Strg+P ein/aus · Strg+↑/↓ Temperatur · F5 oder Strg+R aktualisieren · Strg+G Verlauf · Strg+D Diagnose · Strg+, Einstellungen."/>
                <LineBreak/>
                <Run FontWeight="SemiBold" Text="Symbol per Tastatur:"/>
                <Run Text="Win+B springt in den Infobereich, mit den Pfeiltasten zum Symbol; Enter öffnet das Fenster, Umschalt+F10 das Menü."/>
                <LineBreak/>
                <Run FontWeight="SemiBold" Text="Symbol immer anzeigen:"/>
                <Run Text="Einstellungen → Personalisierung → Taskleiste → Andere Symbole → Klimacontrol einschalten."/>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Updates: nur mit Setup-Installation bedienbar (Updates.Running), sonst Hinweis. -->
          <TextBlock Style="{StaticResource SectionHead}" Text="Updates"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="UpdateVersionText" Style="{StaticResource RowTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Neue Versionen sind signiert und kommen nur von der Release-Seite des Projekts."/>
                </StackPanel>
                <Button x:Name="UpdateCheckButton" Grid.Column="1" VerticalAlignment="Center" Content="Jetzt suchen …"
                        Click="UpdateCheck_Click"/>
              </Grid>
              <TextBlock x:Name="UpdateHelpText" Style="{StaticResource RowHelp}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Visibility="Collapsed"/>
              <TextBlock x:Name="UpdateSetupHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="Automatische Updates gibt es nur mit dem Setup." Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="VersionText" Style="{StaticResource Foot}" Margin="2,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 1 Darstellung: jede Änderung wirkt sofort, die Anzeige folgt `Appearance.Changed`. -->
    <TabItem Header="Darstellung">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">

          <TextBlock Style="{StaticResource SectionHead}" Text="Thema"/>
          <Border Style="{StaticResource Section}">
            <StackPanel Margin="0,2">
              <RadioButton x:Name="ThemeStandard" Style="{StaticResource ThemeChoice}" Tag="standard" Checked="LookTheme_Checked"
                           AutomationProperties.Name="Thema Standard" AutomationProperties.HelpText="Wie bisher: Glas, Farben nach Modus.">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Standard"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Wie bisher: Glas, Farben nach Modus."/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeNight" Style="{StaticResource ThemeChoice}" Tag="night" Checked="LookTheme_Checked"
                           AutomationProperties.Name="Thema Nacht" AutomationProperties.HelpText="Gedimmt und rotarm, angenehm im dunklen Raum.">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Nacht"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Gedimmt und rotarm, angenehm im dunklen Raum."/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeNeon" Style="{StaticResource ThemeChoice}" Tag="neon" Checked="LookTheme_Checked"
                           AutomationProperties.Name="Thema Neon" AutomationProperties.HelpText="Leuchtende Kanten, kräftige Farben.">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Neon"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Leuchtende Kanten, kräftige Farben."/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeMinimal" Style="{StaticResource ThemeChoice}" Tag="minimal" Checked="LookTheme_Checked"
                           AutomationProperties.Name="Thema Minimal" AutomationProperties.HelpText="Dünne Schrift, fast farblos.">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Minimal"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Dünne Schrift, fast farblos."/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ThemeContrast" Style="{StaticResource ThemeChoice}" Tag="contrast" Checked="LookTheme_Checked"
                           AutomationProperties.Name="Thema Kontrast" AutomationProperties.HelpText="Deckende Flächen, gut lesbar.">
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Kontrast"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Deckende Flächen, gut lesbar."/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Foot}" Text="Ein Thema setzt alle Werte darunter auf einmal; danach lässt sich jeder einzeln ändern."/>

          <TextBlock Style="{StaticResource SectionHead}" Text="Farben"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Modus"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Hell, dunkel oder wie Windows."/>
                </StackPanel>
                <ComboBox x:Name="LookModeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Modus" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="System" Tag="system"/>
                  <ComboBoxItem Content="Hell" Tag="light"/>
                  <ComboBoxItem Content="Dunkel" Tag="dark"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Farben"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Nach Modus: Blau beim Kühlen, Orange beim Heizen usw."/>
                </StackPanel>
                <ComboBox x:Name="LookColorsBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Farben" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Nach Modus" Tag="byMode"/>
                  <ComboBoxItem Content="Systemfarbe" Tag="system"/>
                  <ComboBoxItem Content="Eigene" Tag="custom"/>
                </ComboBox>
              </Grid>
              <Grid x:Name="LookSwatchRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Eigene Farbe"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Gilt für alle Modi."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            KeyboardNavigation.DirectionalNavigation="Cycle">
                  <RadioButton x:Name="SwatchOrange" Style="{StaticResource Swatch}" Tag="orange" Background="#F58524"
                               ToolTip="Orange" AutomationProperties.Name="Eigene Farbe Orange" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchBlue" Style="{StaticResource Swatch}" Tag="blue" Background="#3380F2"
                               ToolTip="Blau" AutomationProperties.Name="Eigene Farbe Blau" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchGreen" Style="{StaticResource Swatch}" Tag="green" Background="#33A861"
                               ToolTip="Grün" AutomationProperties.Name="Eigene Farbe Grün" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchPurple" Style="{StaticResource Swatch}" Tag="purple" Background="#9466E6"
                               ToolTip="Lila" AutomationProperties.Name="Eigene Farbe Lila" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchGrey" Style="{StaticResource Swatch}" Tag="gray" Background="#808794" Margin="0"
                               ToolTip="Grau" AutomationProperties.Name="Eigene Farbe Grau" Checked="LookSwatch_Checked"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="LookHighContrastHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"
                         Text="Hoher Kontrast ist in Windows an: Dann gelten die Farben des Kontrastdesigns."/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Hintergrund"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Hintergrund"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Glas lässt den Schreibtisch durchscheinen, Matt ist ruhig und deckend."/>
                </StackPanel>
                <ComboBox x:Name="LookBackgroundBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Hintergrund" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Glas" Tag="glass"/>
                  <ComboBoxItem Content="Glas kräftig" Tag="glassStrong"/>
                  <ComboBoxItem Content="Matt" Tag="matte"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Transparenz"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Wie stark Karten und Fenster durchscheinen."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookTransparency" Style="{StaticResource LookPercentSlider}" Maximum="95"
                          AutomationProperties.Name="Transparenz in Prozent" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookTransparencyText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Unschärfe"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Wie weich der Hintergrund hinter den Karten verschwimmt. Unter Windows kommt sie vom Glas-Effekt des Systems."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookBlur" Style="{StaticResource LookSlider}" Maximum="40"
                          AutomationProperties.Name="Unschärfe" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookBlurText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Große Temperatur"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Leuchten"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Schein in der Modusfarbe um die große Zahl."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookGlow" Style="{StaticResource LookPercentSlider}" Maximum="100"
                          AutomationProperties.Name="Leuchten der Temperatur in Prozent" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookGlowText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Größe"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Größe der großen Zahl und der Bedienelemente."/>
                </StackPanel>
                <ComboBox x:Name="LookSizeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Größe" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Kompakt" Tag="compact"/>
                  <ComboBoxItem Content="Normal" Tag="normal"/>
                  <ComboBoxItem Content="Groß" Tag="large"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Ziffernstil"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Form der großen Zahl, daneben die Vorschau."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="LookDigitPreview" Text="23°" FontSize="26" Foreground="{DynamicResource Fg}"
                             VerticalAlignment="Center" Margin="0,-4,12,-4" AutomationProperties.Name="Vorschau Ziffernstil"/>
                  <ComboBox x:Name="LookDigitsBox" Width="170" VerticalAlignment="Center"
                            AutomationProperties.Name="Ziffernstil" SelectionChanged="Look_SelectionChanged">
                    <ComboBoxItem Content="Dünn" Tag="thin"/>
                    <ComboBoxItem Content="Normal" Tag="normal"/>
                    <ComboBoxItem Content="Fett" Tag="bold"/>
                    <ComboBoxItem Content="Abgerundet" Tag="rounded"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Groß angezeigt"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Welche Temperatur groß steht; die andere steht klein darunter."/>
                </StackPanel>
                <ComboBox x:Name="LookBigBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Groß angezeigt" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Solltemperatur" Tag="target"/>
                  <ComboBoxItem Content="Raumtemperatur" Tag="room"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Umfang"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Einfach: nur Ein/Aus, Modus, Temperatur, Lüfter und Timer, der Rest unter „Mehr …“."/>
                </StackPanel>
                <ComboBox x:Name="LookScopeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Umfang" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Einfach" Tag="simple"/>
                  <ComboBoxItem Content="Alles" Tag="all"/>
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Bewegung"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid x:Name="LookLivingRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Lebendiger Hintergrund"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Langsam fließende Farben, solange die Anlage arbeitet."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookLivingBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Lebendiger Hintergrund" Click="LookToggle_Click"/>
              </Grid>
              <Grid x:Name="LookWeatherRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Wetter-Effekte"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Schneeflocken beim Kühlen, aufsteigende Wärme beim Heizen – dezent."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookWeatherBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Wetter-Effekte" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Animationen reduzieren"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Schaltet lebendigen Hintergrund und Wetter-Effekte immer ab."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookReduceBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Animationen reduzieren" Click="LookToggle_Click"/>
              </Grid>
              <TextBlock x:Name="LookSystemMotionHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"
                         Text="„Animationseffekte“ ist in den Windows-Einstellungen ausgeschaltet (Barrierefreiheit → Visuelle Effekte) – Effekte bleiben aus."/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Fenster"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Immer im Vordergrund"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Das Hauptfenster bleibt über anderen Fenstern."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookOnTopBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Immer im Vordergrund" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Mini-Fenster"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Kleines schwebendes Fenster mit Temperatur und Ein/Aus."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookMiniBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Mini-Fenster" Click="LookToggle_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="Infobereich"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Anzeige"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Was das Symbol im Infobereich und seine Kurzinfo zeigen."/>
                </StackPanel>
                <ComboBox x:Name="LookTooltipBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="Anzeige im Infobereich" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="Nur Symbol" Tag="iconOnly"/>
                  <ComboBoxItem Content="Symbol + Soll" Tag="iconTarget"/>
                  <ComboBoxItem Content="Symbol + Raum" Tag="iconRoom"/>
                  <ComboBoxItem Content="Raum + Soll" Tag="roomTarget"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Symbol farbig"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Symbol in der Modusfarbe statt einfarbig."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookTrayColoredBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Symbol farbig" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="Symbol animiert"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="Der Lüfter dreht sich, solange die Anlage läuft."/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookTrayAnimatedBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="Symbol animiert" Click="LookToggle_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <Button x:Name="LookResetButton" Content="Auf Standard zurücksetzen …" HorizontalAlignment="Left" Margin="0,12,0,4"
                  AutomationProperties.Name="Darstellung auf Standard zurücksetzen" Click="LookReset_Click"/>
          <TextBlock Style="{StaticResource Foot}" Text="Alle Werte dieses Reiters gelten sofort und bleiben gespeichert."/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 2 Verbindung -->
    <TabItem Header="Verbindung">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <StackPanel x:Name="ConnNoDevice" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource RowHelp}" FontSize="13" Text="Noch keine Anlage eingerichtet – das geht im Hauptfenster."/>
            <Button Content="Hauptfenster öffnen" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenMain_Click"/>
          </StackPanel>

          <StackPanel x:Name="ConnPanel">
            <Border Style="{StaticResource Section}" Margin="0,10,0,6">
              <StackPanel>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Status" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="ConnIcon" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnStatus" FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <!-- Meldung des Kerns (messageDetail): Was ist passiert. Was tun. Code klein am Ende. -->
                <TextBlock x:Name="ConnDetail" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"/>
                <Grid x:Name="ModeRow" Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Weg zur Anlage"/>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource RowHelp}"/>
                  </StackPanel>
                  <ComboBox x:Name="ModeBox" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                            AutomationProperties.Name="Weg zur Anlage" SelectionChanged="Mode_Changed"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHead}" Text="Midea-Konto – Steuerung von unterwegs"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <StackPanel x:Name="CloudOn" Visibility="Collapsed">
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Midea-Konto" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CloudAccountText" Grid.Column="1" Style="{StaticResource RowValue}"/>
                  </Grid>
                  <Button Content="Midea-Konto entfernen …" HorizontalAlignment="Left" Margin="0,4,0,4"
                          Foreground="{DynamicResource Bad}" Click="CloudLogout_Click"/>
                </StackPanel>
                <TextBlock x:Name="CloudNoId" Style="{StaticResource RowHelp}" FontSize="13" Margin="0,4" Visibility="Collapsed"
                           Text="Erst eine Anlage einrichten – für das Midea-Konto braucht es die Anlagen-ID."/>
                <StackPanel x:Name="CloudOff">
                  <TextBlock Style="{StaticResource RowHelp}" Foreground="{DynamicResource Warn}" Margin="0,2,0,8"
                             Text="Hinweis: Midea meldet bei jeder Anmeldung „Konto anderswo eingeloggt“. Die Anmeldung auf anderen Geräten kann dadurch enden. Das Midea-Konto in Klimacontrol am besten nur auf einem Rechner benutzen."/>
                  <TextBlock Style="{StaticResource Label}" Text="E-Mail (wie in der App MSmartHome)"/>
                  <TextBox x:Name="CloudUser" AutomationProperties.Name="E-Mail" TextChanged="CloudInput_Changed"/>
                  <TextBlock Style="{StaticResource Label}" Margin="0,8,0,6" Text="Passwort"/>
                  <PasswordBox x:Name="CloudPass" AutomationProperties.Name="Passwort" PasswordChanged="CloudInput_Changed"
                               KeyDown="CloudPass_KeyDown"/>
                  <Button x:Name="CloudLoginButton" Content="Anmelden und speichern" HorizontalAlignment="Left" Margin="0,10,0,4"
                          Style="{StaticResource Primary}" Click="CloudLogin_Click"/>
                </StackPanel>
                <TextBlock x:Name="CloudResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,2" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="CloudFoot" Style="{StaticResource Foot}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 3 Anlage -->
    <TabItem Header="Anlage">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <StackPanel x:Name="DeviceNoDevice" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource RowHelp}" FontSize="13" Text="Noch keine Anlage eingerichtet – das geht im Hauptfenster."/>
            <Button Content="Hauptfenster öffnen" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenMain_Click"/>
            <!-- Nach „Anlage neu einrichten“: wo die beiseitegelegte Datei mit Token und Schlüssel liegt. -->
            <Border x:Name="SetAsidePanel" Style="{StaticResource Section}" Margin="0,16,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="SetAsideText" Style="{StaticResource RowHelp}" FontSize="12.5" Margin="0,2,0,6"/>
                <Button Content="Datenordner öffnen" HorizontalAlignment="Left" Margin="0,0,0,4" Click="SetAsideShow_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="DevicePanel">
            <TextBlock Style="{StaticResource SectionHead}" Text="Anlage"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Name der Anlage"/>
                    <TextBlock Style="{StaticResource RowHelp}" Text="Von Midea vergeben. Der Anzeigename steht unter „Allgemein“."/>
                  </StackPanel>
                  <TextBlock x:Name="DeviceNameText" Grid.Column="1" Style="{StaticResource RowValue}" MaxWidth="240"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Adresse" Margin="0,0,12,0"/>
                  <TextBlock x:Name="AddressText" Grid.Column="1" Style="{StaticResource RowValue}"/>
                </Grid>
                <!-- Router-Wechsel, neue Adresse: Anlage über ihre Anlagen-ID neu suchen, Zugangsdaten bleiben. -->
                <StackPanel x:Name="RelocateRow" Margin="0,2,0,6">
                  <Button x:Name="RelocateButton" Content="Adresse neu suchen" HorizontalAlignment="Left" Click="Relocate_Click"/>
                  <TextBlock Style="{StaticResource RowHelp}" Margin="0,4,0,0"
                             Text="Nach einem Router-Wechsel oder wenn die Anlage eine neue Adresse hat. Token und Schlüssel bleiben erhalten."/>
                  <TextBlock x:Name="RelocateResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Grid x:Name="SoundRow" Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Signalton"/>
                    <TextBlock Style="{StaticResource RowHelp}" Text="Piepen der Anlage bei Befehlen aus dieser App."/>
                  </StackPanel>
                  <local:ClickCheckBox x:Name="BeepBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                            AutomationProperties.Name="Signalton" Click="Beep_Click"/>
                </Grid>
                <!-- Eingeklappt, ohne Token/Schlüssel. -->
                <Expander x:Name="TechExpander" Header="Technische Angaben" Margin="0,6,0,4">
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PortLabel" Text="Port" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="PortText" Grid.Column="1" Margin="0,0,0,4" TextAlignment="Right"/>
                    <TextBlock x:Name="DeviceIdLabel" Grid.Row="1" Text="Anlagen-ID" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="DeviceIdText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="Kennung der Anlage" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"
                               ToolTip="Eigenschaft 0x00AB der Anlage"/>
                    <TextBlock x:Name="IdentifierText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"
                               ToolTip="Eigenschaft 0x00AB der Anlage"/>
                    <TextBlock Grid.Row="3" Text="WLAN-Zugangsdaten" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="CredentialsText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"/>
                  </Grid>
                </Expander>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHead}" Text="Sichern und übertragen"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <!-- Noch nicht gesichert (credentialsBackedUp): Hinweis hervorgehoben. -->
                <TextBlock x:Name="BackupState" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,2" Visibility="Collapsed"/>
                <WrapPanel Margin="0,4">
                  <Button x:Name="ExportButton" Content="Zugangsdaten sichern …" Margin="0,0,6,4" Click="Export_Click"/>
                  <Button x:Name="ImportButton" Content="Sicherung einlesen …" Margin="0,0,6,4" Click="Import_Click"/>
                </WrapPanel>
                <TextBlock x:Name="BackupResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,2" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Foot}"
                       Text="Die Sicherung enthält Token, Schlüssel, Adresse und Szenen – damit lässt sich die Anlage auf einem anderen Rechner ohne Midea-Konto einrichten. Nicht in Cloud-Ordnern (OneDrive, Dropbox, iCloud) ablegen."/>

            <Border Style="{StaticResource Section}" Margin="0,8,0,6">
              <Button Content="Anlage neu einrichten …" HorizontalAlignment="Left" Margin="0,4"
                      Foreground="{DynamicResource Bad}" Click="Forget_Click"/>
            </Border>
            <TextBlock Style="{StaticResource Foot}" Text="Nur für eine andere Anlage. Nach einem Router-Wechsel oder bei neuer Adresse reicht „Adresse neu suchen“."/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 4 Protokoll -->
    <TabItem Header="Protokoll">
      <Grid Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Tile}" CornerRadius="8">
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Padding="6"
                   Background="Transparent" BorderThickness="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"
                   AutomationProperties.Name="Protokoll"/>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <local:ClickCheckBox x:Name="DebugBox" Content="Ausführliches Protokoll" VerticalAlignment="Center" Margin="0,0,16,0" Click="Debug_Click"/>
          <local:ClickCheckBox x:Name="EventsOnlyBox" Grid.Column="1" Content="Nur Ereignisse" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="Blendet die ausführlichen Zeilen (Nachrichten an Anlage und Midea) in der Anzeige aus – die Datei bleibt vollständig"
                    ToolTipService.ShowOnDisabled="True" Click="EventsOnly_Click"/>
          <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" TextAlignment="Right"
                     VerticalAlignment="Center" Text="Ortszeit · Passwort, Token, Schlüssel geschwärzt"/>
        </Grid>
        <TextBlock x:Name="DebugHint" Grid.Row="2" FontSize="11.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Content="Aktualisieren" Margin="6,0,0,0" Click="LogRefresh_Click"/>
          <Button Content="Protokoll im Explorer zeigen" Margin="6,0,0,0" Click="LogShow_Click"/>
          <Button Content="Leeren …" Margin="6,0,0,0" Click="LogClear_Click"/>
        </WrapPanel>
      </Grid>
    </TabItem>

    <!-- 5 Lizenzen: Karten baut der Code beim ersten Öffnen. -->
    <TabItem Header="Lizenzen">
      <ScrollViewer x:Name="NoticesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,12">
          <TextBlock FontSize="12.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Klimacontrol baut auf den folgenden Open-Source-Projekten auf. Ihre Lizenzen verlangen, Urheberrechtsvermerk und Lizenztext mitzugeben."/>
          <StackPanel x:Name="NoticesList"/>
          <!-- Wortgleich mit ThirdPartyNotices.trademarkNote im Kern. -->
          <TextBlock Style="{StaticResource Foot}" Margin="0,4,0,0"
                     Text="Klimacontrol ist kein Produkt von Midea und steht in keiner Verbindung zu Midea. Midea, MSmartHome, NetHome Plus und PortaSplit sind Marken ihrer jeweiligen Inhaber."/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>

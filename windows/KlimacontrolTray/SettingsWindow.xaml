<Window x:Class="KlimacontrolTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KlimacontrolTray"
        xmlns:l="clr-namespace:KlimacontrolTray"
        Title="{l:T app.windows.settingsTitle}" Width="660" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <!-- Reiterreihenfolge fest, muss zu `SettingsTab` passen: Allgemein, Darstellung, Verbindung, Anlage, Protokoll,
       Lizenzen (wie am Mac). -->
  <Window.Resources>
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="2,10,0,6"/>
    </Style>
    <Style x:Key="Foot" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedFoot}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedFoot}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Eine Einstellungszeile: links Titel/Erklärung, rechts das Bedienelement. -->
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,6"/>
    </Style>
    <!-- Darstellung: Farbkreis als Auswahl (RadioButton). Ring = gewählt, halber Ring = Maus darüber. -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="LookColor"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Fg}" StrokeThickness="2" Opacity="0"/>
              <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LookSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Width" Value="170"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="TickFrequency" Value="1"/>
      <Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="SmallChange" Value="1"/>
      <Setter Property="LargeChange" Value="5"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Transparenz und Leuchten in 5-%-Schritten wie am Mac (Schritt 0,05). -->
    <Style x:Key="LookPercentSlider" TargetType="Slider" BasedOn="{StaticResource LookSlider}">
      <Setter Property="TickFrequency" Value="5"/>
      <Setter Property="SmallChange" Value="5"/>
      <Setter Property="LargeChange" Value="10"/>
    </Style>
    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="Width" Value="44"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeFixedBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Themenkachel: Hintergrund und Inhalt setzt `SettingsWindow.Appearance.cs` aus der Palette des Themas. -->
    <Style x:Key="ThemeTile" TargetType="RadioButton">
      <Setter Property="GroupName" Value="LookTheme"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="4,8" MinHeight="78">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Sub}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Fg}"/>
                <Setter TargetName="Box" Property="BorderThickness" Value="2.5"/>
                <Setter TargetName="Box" Property="Padding" Value="2.5,6.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl x:Name="Tabs" Margin="12">

    <!-- 0 Allgemein -->
    <TabItem Header="{l:T settings.tabs.general}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.language.title}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.language.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.language.restartHint}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ComboBox x:Name="LanguageBox" Width="170" HorizontalAlignment="Right"
                            AutomationProperties.Name="{l:T settings.general.languageAccessibility}" SelectionChanged="Language_Changed">
                    <ComboBoxItem Content="{l:T settings.language.system}" Tag="system"/>
                    <ComboBoxItem Content="{l:T settings.language.german}" Tag="de"/>
                    <ComboBoxItem Content="{l:T settings.language.english}" Tag="en"/>
                  </ComboBox>
                  <Button x:Name="RestartButton" Content="{l:T app.restartNow}" HorizontalAlignment="Right" Margin="0,6,0,0"
                          Visibility="Collapsed" Click="Restart_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="LanguageResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.sectionDisplay}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.nameTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.windows.nameHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="NameBox" Width="190" AutomationProperties.Name="{l:T settings.general.nameAccessibility}" KeyDown="Name_KeyDown"/>
                  <Button Content="{l:T settings.general.apply}" Margin="6,0,0,0" Click="Name_Click"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.priceTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.priceHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="PriceBox" Width="70" TextAlignment="Right" KeyDown="Price_KeyDown"/>
                  <TextBlock x:Name="PriceUnit" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Sub}"/>
                  <Button Content="{l:T settings.general.apply}" Margin="6,0,0,0" Click="Price_Click"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.currency.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.currencyHelp}"/>
                </StackPanel>
                <TextBox x:Name="CurrencyBox" Grid.Column="1" Width="56" MaxLength="3" TextAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.Name="{l:T settings.general.currencyAccessibility}"
                         KeyDown="Currency_KeyDown" LostKeyboardFocus="Currency_LostFocus"/>
              </Grid>
              <TextBlock x:Name="CurrencyResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.sectionRefresh}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.refreshTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.refreshHelp}"/>
                </StackPanel>
                <ComboBox x:Name="RefreshBox" Grid.Column="1" Width="160" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.general.refreshTitle}" SelectionChanged="Refresh_Changed"/>
              </Grid>
              <Grid x:Name="CustomRefreshPanel" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="CustomRefreshTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="CustomRefreshHelp" Style="{StaticResource RowHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="CustomRefreshBox" Width="60" TextAlignment="Right" KeyDown="CustomRefresh_KeyDown"
                           AutomationProperties.Name="{l:T settings.general.customAccessibility}"/>
                  <TextBlock Text="{l:T settings.general.secondsUnit}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Sub}"/>
                  <Button Content="{l:T settings.general.apply}" Margin="6,0,0,0" Click="CustomRefresh_Click"/>
                </StackPanel>
              </Grid>
              <DockPanel x:Name="RefreshWarn" Margin="0,4,0,4" Visibility="Collapsed">
                <Path x:Name="RefreshWarnIcon" DockPanel.Dock="Left" Width="14" Height="14" Stretch="Uniform" Margin="0,1,6,0"
                      VerticalAlignment="Top" Stroke="{DynamicResource Warn}" StrokeThickness="1.4"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="RefreshWarnText" FontSize="11.5" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.sectionHistory}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.csvTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.csvHelp}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="HistoryCsvBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.general.csvTitle}" Click="HistoryCsv_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.exportTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.windows.exportHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{l:T common.windows.showInExplorer}" Click="HistoryShow_Click"/>
                  <Button Content="{l:T settings.general.exportButton}" Margin="6,0,0,0" Click="HistoryExport_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="HistoryResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Der Autostart-Eintrag startet mit "- -tray" nur im Infobereich. -->
          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.sectionStart}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.windows.autostartTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}"
                             Text="{l:T settings.general.windows.autostartHelp}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="AutostartBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.general.windows.autostartTitle}" Click="Autostart_Click"/>
              </Grid>
              <TextBlock x:Name="AutostartHint" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,6"
                         Foreground="{DynamicResource Warn}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.windows.sectionKeyboard}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.windows.hotkeyTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.windows.hotkeyHelp}"/>
                </StackPanel>
                <ComboBox x:Name="HotkeyBox" Grid.Column="1" Width="190" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.general.windows.hotkeyAccessibility}"
                          SelectionChanged="Hotkey_Changed"/>
              </Grid>
              <Grid x:Name="HotkeyRecordPanel" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.windows.customTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.windows.customHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="HotkeyRecordBox" Width="150" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                           TextAlignment="Center" AutomationProperties.Name="{l:T settings.general.windows.customAccessibility}"
                           PreviewKeyDown="HotkeyRecord_PreviewKeyDown"/>
                  <Button Content="{l:T common.cancel}" Margin="6,0,0,0" Click="HotkeyRecordCancel_Click"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="HotkeyResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,4" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource RowHelp}" Margin="0,6,0,4" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{l:T settings.general.windows.inWindowLabel}"/>
                <Run x:Name="InWindowKeysRun"/>
                <LineBreak/>
                <Run FontWeight="SemiBold" Text="{l:T settings.general.windows.iconKeysLabel}"/>
                <Run x:Name="IconKeysRun"/>
                <LineBreak/>
                <Run FontWeight="SemiBold" Text="{l:T settings.general.windows.iconAlwaysLabel}"/>
                <Run Text="{l:T settings.general.windows.iconAlways}"/>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Updates: nur mit Setup-Installation bedienbar (Updates.Running), sonst Hinweis. -->
          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.general.updatesSection}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="UpdateVersionText" Style="{StaticResource RowTitle}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.windows.updatesSigned}"/>
                </StackPanel>
                <Button x:Name="UpdateCheckButton" Grid.Column="1" VerticalAlignment="Center" Content="{l:T updates.checkButton}"
                        Click="UpdateCheck_Click"/>
              </Grid>
              <TextBlock x:Name="UpdateHelpText" Style="{StaticResource RowHelp}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Visibility="Collapsed"/>
              <Grid x:Name="UpdateHeldRow" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateHeldText" Style="{StaticResource RowHelp}" Margin="0,0,12,0" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button x:Name="UpdateInstallButton" Grid.Column="1" VerticalAlignment="Center" Click="UpdateInstall_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="UpdateAutoInstallTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="UpdateAutoInstallHelp" Style="{StaticResource RowHelp}" TextWrapping="Wrap"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="UpdateAutoInstallBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          Click="UpdateAutoInstall_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock x:Name="UpdateIntervalTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="UpdateIntervalHelp" Style="{StaticResource RowHelp}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                <ComboBox x:Name="UpdateIntervalBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          SelectionChanged="UpdateInterval_Changed"/>
              </Grid>
              <TextBlock Style="{StaticResource RowHelp}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="{l:T settings.general.windows.updatesHeldLimit}"/>
              <TextBlock x:Name="UpdateSetupHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="{l:T settings.general.windows.updatesSetupOnly}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock x:Name="VersionText" Style="{StaticResource Foot}" Margin="2,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 1 Darstellung: jede Änderung wirkt sofort, die Anzeige folgt `Appearance.Changed`. -->
    <TabItem Header="{l:T settings.tabs.appearance}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.appearance.theme.title}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <UniformGrid Columns="5" Margin="-3,2,-3,4" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="ThemeStandard" Style="{StaticResource ThemeTile}" Tag="standard" Checked="LookTheme_Checked"
                             ToolTip="{l:T settings.appearance.windows.themeStandardHelp}"
                             AutomationProperties.HelpText="{l:T settings.appearance.windows.themeStandardHelp}"/>
                <RadioButton x:Name="ThemeNight" Style="{StaticResource ThemeTile}" Tag="night" Checked="LookTheme_Checked"
                             ToolTip="{l:T settings.appearance.windows.themeNightHelp}"
                             AutomationProperties.HelpText="{l:T settings.appearance.windows.themeNightHelp}"/>
                <RadioButton x:Name="ThemeNeon" Style="{StaticResource ThemeTile}" Tag="neon" Checked="LookTheme_Checked"
                             ToolTip="{l:T settings.appearance.windows.themeNeonHelp}"
                             AutomationProperties.HelpText="{l:T settings.appearance.windows.themeNeonHelp}"/>
                <RadioButton x:Name="ThemeMinimal" Style="{StaticResource ThemeTile}" Tag="minimal" Checked="LookTheme_Checked"
                             ToolTip="{l:T settings.appearance.windows.themeMinimalHelp}"
                             AutomationProperties.HelpText="{l:T settings.appearance.windows.themeMinimalHelp}"/>
                <RadioButton x:Name="ThemeContrast" Style="{StaticResource ThemeTile}" Tag="contrast" Checked="LookTheme_Checked"
                             ToolTip="{l:T settings.appearance.windows.themeContrastHelp}"
                             AutomationProperties.HelpText="{l:T settings.appearance.windows.themeContrastHelp}"/>
              </UniformGrid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.scheme.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.windows.schemeHelp}"/>
                </StackPanel>
                <ComboBox x:Name="LookModeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.scheme.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.scheme.system}" Tag="system"/>
                  <ComboBoxItem Content="{l:T appearance.scheme.light}" Tag="light"/>
                  <ComboBoxItem Content="{l:T appearance.scheme.dark}" Tag="dark"/>
                </ComboBox>
              </Grid>
              <Grid x:Name="LookRestoreRow" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.theme.restore}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.theme.restoreHelp}"/>
                </StackPanel>
                <Button x:Name="LookRestoreButton" Grid.Column="1" VerticalAlignment="Center" Content="{l:T settings.appearance.theme.restore}"
                        Click="LookRestore_Click"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Foot}" Text="{l:T settings.appearance.theme.help}"/>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.appearance.display.section}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.size.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.size.help}"/>
                </StackPanel>
                <ComboBox x:Name="LookSizeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.size.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.size.compact}" Tag="compact"/>
                  <ComboBoxItem Content="{l:T appearance.size.normal}" Tag="normal"/>
                  <ComboBoxItem Content="{l:T appearance.size.large}" Tag="large"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.heroValue.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.heroValue.help}"/>
                </StackPanel>
                <ComboBox x:Name="LookBigBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.heroValue.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.hero.target}" Tag="target"/>
                  <ComboBoxItem Content="{l:T appearance.hero.room}" Tag="room"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.scope.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.scope.help}"/>
                </StackPanel>
                <ComboBox x:Name="LookScopeBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.scope.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.scope.simple}" Tag="simple"/>
                  <ComboBoxItem Content="{l:T appearance.scope.all}" Tag="all"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.temperatureCombined.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.temperatureCombined.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookTemperatureCombinedBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.temperatureCombined.title}"
                          AutomationProperties.HelpText="{l:T settings.appearance.temperatureCombined.help}" Click="LookToggle_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.appearance.windowNotify.section}"/>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.alwaysOnTop.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.alwaysOnTop.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookOnTopBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.alwaysOnTop.title}" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.menuBar.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.windows.trayHelp}"/>
                </StackPanel>
                <ComboBox x:Name="LookTooltipBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.windows.trayAccessibility}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.menuBar.iconOnly}" Tag="iconOnly"/>
                  <ComboBoxItem Content="{l:T appearance.menuBar.iconTarget}" Tag="iconTarget"/>
                  <ComboBoxItem Content="{l:T appearance.menuBar.iconRoom}" Tag="iconRoom"/>
                  <ComboBoxItem Content="{l:T appearance.menuBar.roomTarget}" Tag="roomTarget"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.menuBarColored.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.menuBarColored.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookTrayColoredBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.menuBarColored.title}" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.mini.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.windows.miniHelp}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookMiniBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.mini.title}" Click="LookToggle_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <Expander x:Name="LookCustomize" Margin="0,10,0,6" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{l:T settings.appearance.customize.title}"
                    AutomationProperties.HelpText="{l:T settings.appearance.customize.help}">
            <Expander.Header>
              <StackPanel Margin="0,2">
                <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold" Text="{l:T settings.appearance.customize.title}"/>
                <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.customize.help}"/>
              </StackPanel>
            </Expander.Header>
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.colors.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.accent.help}"/>
                </StackPanel>
                <ComboBox x:Name="LookColorsBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.colors.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.accent.byMode}" Tag="byMode"/>
                  <ComboBoxItem Content="{l:T appearance.accent.system}" Tag="system"/>
                  <ComboBoxItem Content="{l:T appearance.accent.custom}" Tag="custom"/>
                </ComboBox>
              </Grid>
              <Grid x:Name="LookSwatchRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.customColor.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.customColor.help}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            KeyboardNavigation.DirectionalNavigation="Cycle">
                  <RadioButton x:Name="SwatchOrange" Style="{StaticResource Swatch}" Tag="orange" Background="#F58524"
                               ToolTip="{l:T appearance.color.orange}" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchBlue" Style="{StaticResource Swatch}" Tag="blue" Background="#3380F2"
                               ToolTip="{l:T appearance.color.blue}" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchGreen" Style="{StaticResource Swatch}" Tag="green" Background="#33A861"
                               ToolTip="{l:T appearance.color.green}" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchPurple" Style="{StaticResource Swatch}" Tag="purple" Background="#9466E6"
                               ToolTip="{l:T appearance.color.purple}" Checked="LookSwatch_Checked"/>
                  <RadioButton x:Name="SwatchGrey" Style="{StaticResource Swatch}" Tag="gray" Background="#808794" Margin="0"
                               ToolTip="{l:T appearance.color.gray}" Checked="LookSwatch_Checked"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="LookHighContrastHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"
                         Text="{l:T settings.appearance.windows.highContrast}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.background.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.background.help}"/>
                </StackPanel>
                <ComboBox x:Name="LookBackgroundBox" Grid.Column="1" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.background.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.background.glass}" Tag="glass"/>
                  <ComboBoxItem Content="{l:T appearance.background.glassStrong}" Tag="glassStrong"/>
                  <ComboBoxItem Content="{l:T appearance.background.matte}" Tag="matte"/>
                </ComboBox>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.transparency.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.transparency.help}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookTransparency" Style="{StaticResource LookPercentSlider}" Maximum="95"
                          AutomationProperties.Name="{l:T settings.appearance.windows.transparencyAccessibility}" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookTransparencyText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.blur.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.windows.blurHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookBlur" Style="{StaticResource LookSlider}" Maximum="40"
                          AutomationProperties.Name="{l:T settings.appearance.blur.title}" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookBlurText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.glow.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.glow.help}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="LookGlow" Style="{StaticResource LookPercentSlider}" Maximum="100"
                          AutomationProperties.Name="{l:T settings.appearance.windows.glowAccessibility}" ValueChanged="LookSlider_ValueChanged"/>
                  <TextBlock x:Name="LookGlowText" Style="{StaticResource SliderValue}"/>
                </StackPanel>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.digits.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.windows.digitsHelp}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="LookDigitPreview" Text="23°" FontSize="26" Foreground="{DynamicResource Fg}"
                             VerticalAlignment="Center" Margin="0,-4,12,-4" AutomationProperties.Name="{l:T settings.appearance.windows.digitsPreviewName}"/>
                <ComboBox x:Name="LookDigitsBox" Width="170" VerticalAlignment="Center"
                          AutomationProperties.Name="{l:T settings.appearance.digits.title}" SelectionChanged="Look_SelectionChanged">
                  <ComboBoxItem Content="{l:T appearance.digits.thin}" Tag="thin"/>
                  <ComboBoxItem Content="{l:T appearance.digits.normal}" Tag="normal"/>
                  <ComboBoxItem Content="{l:T appearance.digits.bold}" Tag="bold"/>
                  <ComboBoxItem Content="{l:T appearance.digits.rounded}" Tag="rounded"/>
                </ComboBox>
                </StackPanel>
              </Grid>
              <Grid x:Name="LookLivingRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.lively.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.lively.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookLivingBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.lively.title}" Click="LookToggle_Click"/>
              </Grid>
              <Grid x:Name="LookWeatherRow" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.weather.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.weather.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookWeatherBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.weather.title}" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.menuBarAnimated.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.menuBarAnimated.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookTrayAnimatedBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.menuBarAnimated.title}" Click="LookToggle_Click"/>
              </Grid>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.appearance.reduceMotion.title}"/>
                  <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.appearance.reduceMotion.help}"/>
                </StackPanel>
                <local:ClickCheckBox x:Name="LookReduceBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          AutomationProperties.Name="{l:T settings.appearance.reduceMotion.title}" Click="LookToggle_Click"/>
              </Grid>
              <TextBlock x:Name="LookSystemMotionHint" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"
                         Text="{l:T settings.appearance.windows.reduceMotionSystem}"/>
            </StackPanel>
          </Border>
          </Expander>

          <Button x:Name="LookResetButton" Content="{l:T settings.appearance.reset.button}" HorizontalAlignment="Left" Margin="0,12,0,4"
                  AutomationProperties.Name="{l:T settings.appearance.windows.resetAccessibility}" Click="LookReset_Click"/>
          <TextBlock Style="{StaticResource Foot}" Text="{l:T settings.appearance.windows.footer}"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 2 Verbindung -->
    <TabItem Header="{l:T settings.tabs.connection}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <StackPanel x:Name="ConnNoDevice" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource RowHelp}" FontSize="13" Text="{l:T settings.connection.noDevice}"/>
            <Button Content="{l:T settings.connection.windows.openMain}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenMain_Click"/>
          </StackPanel>

          <StackPanel x:Name="ConnPanel">
            <Border Style="{StaticResource Section}" Margin="0,10,0,6">
              <StackPanel>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.connection.status}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="ConnIcon" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnStatus" FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <!-- Meldung des Kerns (messageDetail): Was ist passiert. Was tun. Code klein am Ende. -->
                <TextBlock x:Name="ConnDetail" Style="{StaticResource RowHelp}" Margin="0,0,0,6" Visibility="Collapsed"/>
                <Grid x:Name="ModeRow" Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.connection.wayTitle}"/>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource RowHelp}"/>
                  </StackPanel>
                  <ComboBox x:Name="ModeBox" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                            AutomationProperties.Name="{l:T settings.connection.wayTitle}" SelectionChanged="Mode_Changed"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.connection.accountHeader}"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <StackPanel x:Name="CloudOn" Visibility="Collapsed">
                  <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.connection.accountTitle}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CloudAccountText" Grid.Column="1" Style="{StaticResource RowValue}"/>
                  </Grid>
                  <Button Content="{l:T settings.connection.accountRemove}" HorizontalAlignment="Left" Margin="0,4,0,4"
                          Foreground="{DynamicResource Bad}" Click="CloudLogout_Click"/>
                </StackPanel>
                <TextBlock x:Name="CloudNoId" Style="{StaticResource RowHelp}" FontSize="13" Margin="0,4" Visibility="Collapsed"
                           Text="{l:T settings.connection.needsDevice}"/>
                <StackPanel x:Name="CloudOff">
                  <TextBlock Style="{StaticResource RowHelp}" Foreground="{DynamicResource Warn}" Margin="0,2,0,8"
                             Text="{l:T settings.connection.windows.hint}"/>
                  <TextBlock Style="{StaticResource Label}" Text="{l:T settings.connection.emailPlaceholder}"/>
                  <TextBox x:Name="CloudUser" AutomationProperties.Name="{l:T settings.connection.windows.emailAccessibility}" TextChanged="CloudInput_Changed"/>
                  <TextBlock Style="{StaticResource Label}" Margin="0,8,0,6" Text="{l:T settings.connection.passwordPlaceholder}"/>
                  <PasswordBox x:Name="CloudPass" AutomationProperties.Name="{l:T settings.connection.passwordPlaceholder}" PasswordChanged="CloudInput_Changed"
                               KeyDown="CloudPass_KeyDown"/>
                  <Button x:Name="CloudLoginButton" Content="{l:T settings.connection.signIn}" HorizontalAlignment="Left" Margin="0,10,0,4"
                          Style="{StaticResource Primary}" Click="CloudLogin_Click"/>
                </StackPanel>
                <TextBlock x:Name="CloudResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,2" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="CloudFoot" Style="{StaticResource Foot}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 3 Anlage -->
    <TabItem Header="{l:T settings.tabs.device}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
          <StackPanel x:Name="DeviceNoDevice" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource RowHelp}" FontSize="13" Text="{l:T settings.device.noDevice}"/>
            <Button Content="{l:T settings.connection.windows.openMain}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenMain_Click"/>
            <!-- Nach „Anlage neu einrichten“: wo die beiseitegelegte Datei mit Token und Schlüssel liegt. -->
            <Border x:Name="SetAsidePanel" Style="{StaticResource Section}" Margin="0,16,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="SetAsideText" Style="{StaticResource RowHelp}" FontSize="12.5" Margin="0,2,0,6"/>
                <Button Content="{l:T settings.device.windows.openDataFolder}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="SetAsideShow_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="DevicePanel">
            <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.device.section}"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.device.name.title}"/>
                    <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.device.name.help}"/>
                  </StackPanel>
                  <TextBlock x:Name="DeviceNameText" Grid.Column="1" Style="{StaticResource RowValue}" MaxWidth="240"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource RowTitle}" Text="{l:T setup.found.address}" Margin="0,0,12,0"/>
                  <TextBlock x:Name="AddressText" Grid.Column="1" Style="{StaticResource RowValue}"/>
                </Grid>
                <!-- Router-Wechsel, neue Adresse: Anlage über ihre Anlagen-ID neu suchen, Zugangsdaten bleiben. -->
                <StackPanel x:Name="RelocateRow" Margin="0,2,0,6">
                  <Button x:Name="RelocateButton" Content="{l:T settings.device.relocate.button}" HorizontalAlignment="Left" Click="Relocate_Click"/>
                  <TextBlock Style="{StaticResource RowHelp}" Margin="0,4,0,0"
                             Text="{l:T settings.device.relocate.help}"/>
                  <TextBlock x:Name="RelocateResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Grid x:Name="SoundRow" Style="{StaticResource Row}">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T settings.general.soundTitle}"/>
                    <TextBlock Style="{StaticResource RowHelp}" Text="{l:T settings.general.soundHelp}"/>
                  </StackPanel>
                  <local:ClickCheckBox x:Name="BeepBox" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                            AutomationProperties.Name="{l:T settings.general.soundTitle}" Click="Beep_Click"/>
                </Grid>
                <!-- Eingeklappt, ohne Token/Schlüssel. -->
                <Expander x:Name="TechExpander" Header="{l:T settings.device.details.title}" Margin="0,6,0,4">
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PortLabel" Text="{l:T setup.found.port}" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="PortText" Grid.Column="1" Margin="0,0,0,4" TextAlignment="Right"/>
                    <TextBlock x:Name="DeviceIdLabel" Grid.Row="1" Text="{l:T setup.found.applianceId}" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="DeviceIdText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="{l:T settings.device.identifier.title}" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"
                               ToolTip="{l:T settings.device.identifier.help}"/>
                    <TextBlock x:Name="IdentifierText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"
                               ToolTip="{l:T settings.device.identifier.help}"/>
                    <TextBlock Grid.Row="3" Text="{l:T settings.device.credentials.title}" Foreground="{DynamicResource Sub}" Margin="0,0,16,4"/>
                    <TextBlock x:Name="CredentialsText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" TextWrapping="Wrap" TextAlignment="Right"/>
                  </Grid>
                </Expander>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHead}" Text="{l:T settings.device.backup.header}"/>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <!-- Noch nicht gesichert (credentialsBackedUp): Hinweis hervorgehoben. -->
                <TextBlock x:Name="BackupState" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,2" Visibility="Collapsed"/>
                <WrapPanel Margin="0,4">
                  <Button x:Name="ExportButton" Content="{l:T settings.device.backup.export}" Margin="0,0,6,4" Click="Export_Click"/>
                  <Button x:Name="ImportButton" Content="{l:T settings.device.backup.import}" Margin="0,0,6,4" Click="Import_Click"/>
                </WrapPanel>
                <TextBlock x:Name="BackupResult" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,2" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Foot}"
                       Text="{l:T settings.device.backup.footer}"/>

            <Border Style="{StaticResource Section}" Margin="0,8,0,6">
              <Button Content="{l:T settings.device.forget.button}" HorizontalAlignment="Left" Margin="0,4"
                      Foreground="{DynamicResource Bad}" Click="Forget_Click"/>
            </Border>
            <TextBlock Style="{StaticResource Foot}" Text="{l:T settings.device.forget.footer}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 4 Protokoll -->
    <TabItem Header="{l:T settings.tabs.log}">
      <Grid Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Tile}" CornerRadius="8">
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Padding="6"
                   Background="Transparent" BorderThickness="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"
                   AutomationProperties.Name="{l:T settings.tabs.log}"/>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <local:ClickCheckBox x:Name="DebugBox" Content="{l:T settings.log.detailed.title}" VerticalAlignment="Center" Margin="0,0,16,0" Click="Debug_Click"/>
          <local:ClickCheckBox x:Name="EventsOnlyBox" Grid.Column="1" Content="{l:T settings.log.eventsOnly.title}" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="{l:T settings.log.windows.eventsOnlyHelp}"
                    ToolTipService.ShowOnDisabled="True" Click="EventsOnly_Click"/>
          <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" TextAlignment="Right"
                     VerticalAlignment="Center" Text="{l:T settings.log.legend}"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,4,0,0">
          <TextBlock x:Name="LogDebugNote" FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,2" Visibility="Collapsed"/>
          <TextBlock x:Name="DebugHint" FontSize="11.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"
                     Text="{l:T settings.log.detailed.scope}"/>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Content="{l:T settings.log.refresh}" Margin="6,0,0,0" Click="LogRefresh_Click"/>
          <Button Content="{l:T settings.log.windows.showInExplorer}" Margin="6,0,0,0" Click="LogShow_Click"/>
          <Button Content="{l:T settings.log.clear.button}" Margin="6,0,0,0" Click="LogClear_Click"/>
        </WrapPanel>
      </Grid>
    </TabItem>

    <!-- 5 Lizenzen: Karten baut der Code beim ersten Öffnen. -->
    <TabItem Header="{l:T settings.tabs.notices}">
      <ScrollViewer x:Name="NoticesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,12">
          <TextBlock FontSize="12.5" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="{l:T notices.intro}"/>
          <StackPanel x:Name="NoticesList"/>
          <!-- Wortgleich mit ThirdPartyNotices.trademarkNote im Kern. -->
          <TextBlock Style="{StaticResource Foot}" Margin="0,4,0,0"
                     Text="{l:T notices.windows.trademarks}"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>

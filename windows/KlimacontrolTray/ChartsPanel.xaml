<UserControl x:Class="KlimacontrolTray.ChartsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KlimacontrolTray"
             xmlns:l="clr-namespace:KlimacontrolTray">
  <!-- Die Graphen teilen sich die freie Höhe (2 : 3 : 2); ohne Außenwerte bekommt OutdoorRow die Höhe 0. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="3*"/>
      <RowDefinition x:Name="OutdoorRow" Height="0"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="CloseButton" Padding="6" Click="Close_Click" VerticalAlignment="Center"
              AutomationProperties.Name="{l:T charts.hide}"/>
      <ContentControl x:Name="TitleIcon" Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="{l:T charts.title}" TextTrimming="CharacterEllipsis"/>
      <StackPanel x:Name="RangePanel" Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0"
                  AutomationProperties.Name="{l:T charts.range}"/>
    </Grid>
    <UniformGrid x:Name="Tiles" Grid.Row="1" Rows="1" Margin="-4,12,-4,0"/>
    <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="0,40" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
               FontSize="13" Foreground="{DynamicResource Sub}"
               Text="{l:T charts.windows.tooFew}" Visibility="Collapsed"/>
    <Border x:Name="PowerCard" Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Tile}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ContentControl x:Name="PowerIcon" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="{l:T charts.power}"/>
        </StackPanel>
        <Canvas x:Name="PowerCanvas" Grid.Row="1" MinHeight="70" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"
                MouseMove="Canvas_MouseMove" MouseLeave="Canvas_MouseLeave"/>
      </Grid>
    </Border>
    <Border x:Name="TempCard" Grid.Row="4" Margin="0,12,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Tile}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ContentControl x:Name="TempIcon" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="{l:T charts.temperature}"/>
        </StackPanel>
        <Canvas x:Name="TempCanvas" Grid.Row="1" MinHeight="90" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"
                MouseMove="Canvas_MouseMove" MouseLeave="Canvas_MouseLeave"/>
        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <Ellipse x:Name="IndoorDot" Width="8" Height="8" Fill="{DynamicResource Fg}" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource Sub}" Margin="4,0,12,0" Text="{l:T charts.series.room}"/>
          <Ellipse x:Name="TargetDot" Width="8" Height="8" Fill="#D9408C" VerticalAlignment="Center"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource Sub}" Margin="4,0,0,0" Text="{l:T charts.series.target}"/>
        </WrapPanel>
      </Grid>
    </Border>
    <Border x:Name="OutdoorCard" Grid.Row="5" Margin="0,12,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Tile}"
            Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ContentControl x:Name="OutdoorIcon" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="{l:T charts.outdoor}"/>
        </StackPanel>
        <Canvas x:Name="OutdoorCanvas" Grid.Row="1" MinHeight="60" Margin="0,8,0,0" ClipToBounds="True" Background="Transparent"
                MouseMove="Canvas_MouseMove" MouseLeave="Canvas_MouseLeave"/>
      </Grid>
    </Border>
    <local:EnergyCard x:Name="Energy" Grid.Row="6" Margin="0,12,0,0"/>
  </Grid>
</UserControl>

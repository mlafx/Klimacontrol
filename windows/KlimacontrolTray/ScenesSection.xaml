<UserControl x:Class="KlimacontrolTray.ScenesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,12,0,0">
  <!-- Standardmäßig eingeklappt; die Knöpfe baut ScenesSection.xaml.cs. -->
  <Expander x:Name="ScenesExpander" Expanded="Scenes_Changed" Collapsed="Scenes_Changed">
    <!-- Eigene, ruhige Vorlage statt der Fluent-Karte: Titel links, Pfeil rechts, kein Rahmen. -->
    <Expander.Template>
      <ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Content="{TemplateBinding Header}" Cursor="Hand" HorizontalAlignment="Stretch"
                        ToolTip="Szenen ein- oder ausblenden">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Box" Background="Transparent" MinHeight="22" Padding="0,2">
                  <DockPanel>
                    <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10" Text="&#xE70D;" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                               Margin="8,0,2,0"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Expander.Template>
    <Expander.Header>
      <TextBlock x:Name="HeaderText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Text="SZENEN"
                 TextTrimming="CharacterEllipsis"/>
    </Expander.Header>

    <StackPanel Margin="0,6,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ScenesHint" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,12,0" Text="Noch keine Szenen – stelle die Anlage ein und sichere den Zustand mit +."/>
        <Button x:Name="SceneAdd" Grid.Column="1" FontSize="12" Padding="10,4" VerticalAlignment="Top" Click="SceneAdd_Click"
                ToolTip="Aktuellen Zustand als Szene sichern"/>
      </Grid>

      <!-- Name der neuen Szene -->
      <StackPanel x:Name="SceneNameRow" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Text="Name"/>
          <TextBox x:Name="SceneNameBox" Grid.Column="1" AutomationProperties.Name="Name der Szene" KeyDown="SceneName_KeyDown" TextChanged="SceneName_TextChanged"/>
          <Button x:Name="SceneSaveButton" Grid.Column="2" Content="Sichern" Margin="6,0,0,0" IsEnabled="False"
                  Style="{StaticResource Primary}" Click="SceneSave_Click"/>
          <Button Grid.Column="3" Content="Abbrechen" Margin="6,0,0,0" Click="SceneCancel_Click"/>
        </Grid>
        <TextBlock FontSize="11" Foreground="{DynamicResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Speichert Ein/Aus, Modus, Temperatur, Lüfter, Schwenken, Eco, Ionisierer und „Außengerät leise“."/>
      </StackPanel>

      <UniformGrid x:Name="SceneGrid" Columns="2" Margin="-3,6,-3,0"/>
    </StackPanel>
  </Expander>
</UserControl>
